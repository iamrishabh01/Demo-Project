/* =========================================================
   USER FORM
   ========================================================= */

.user-form {
  width: 100%;
  max-width: 980px;
  margin: 0 auto;
  background: #ffffff;
  color: #18181b;
}


/* =========================================================
   FORM HEADER
   ========================================================= */

.user-form-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  padding: 26px 30px;
  border-bottom: 1px solid #e4e4e7;
}

.user-form-header h2 {
  margin: 0;
  font-size: 22px;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #18181b;
}

.user-form-header p {
  margin: 7px 0 0;
  color: #71717a;
  font-size: 13px;
  line-height: 1.5;
}

.form-close-button {
  width: 36px;
  height: 36px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #e4e4e7;
  border-radius: 8px;

  background: #ffffff;
  color: #52525b;

  transition:
    background 160ms ease,
    color 160ms ease,
    border-color 160ms ease,
    transform 160ms ease;
}

.form-close-button:hover {
  background: #f4f4f5;
  color: #18181b;
  border-color: #d4d4d8;
}

.form-close-button:active {
  transform: scale(0.96);
}


/* =========================================================
   FORM STATUS
   ========================================================= */

.form-status-error {
  margin: 20px 30px 0;
  padding: 12px 14px;

  border: 1px solid #fecaca;
  border-radius: 8px;

  background: #fef2f2;
  color: #b91c1c;

  font-size: 13px;
  line-height: 1.5;
}


/* =========================================================
   FORM SECTIONS
   ========================================================= */

.form-section {
  padding: 28px 30px;
  border-bottom: 1px solid #e4e4e7;
}

.form-section:last-of-type {
  border-bottom: none;
}

.form-section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 20px;
}

.form-section-header h3 {
  margin: 0;

  font-size: 15px;
  font-weight: 700;
  color: #18181b;

  letter-spacing: -0.01em;
}

.form-section-header span {
  color: #a1a1aa;
  font-size: 12px;
}


/* =========================================================
   FORM GRID
   ========================================================= */

.form-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 20px;
}


/* =========================================================
   FORM GROUP
   ========================================================= */

.form-group {
  min-width: 0;
}

.form-group > label {
  display: block;

  margin-bottom: 7px;

  color: #27272a;

  font-size: 13px;
  font-weight: 600;
}

.required {
  margin-left: 3px;
  color: #dc2626;
}


/* =========================================================
   INPUTS
   ========================================================= */

.form-group input[type="text"],
.form-group input[type="email"],
.form-group input[type="number"],
.form-group input[type="date"],
.form-group select,
.form-group textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 42px;

  padding: 10px 12px;

  border: 1px solid #d4d4d8;
  border-radius: 7px;

  outline: none;

  background: #ffffff;
  color: #18181b;

  font-size: 13px;

  transition:
    border-color 160ms ease,
    box-shadow 160ms ease,
    background 160ms ease;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #a1a1aa;
}

.form-group input:hover,
.form-group select:hover,
.form-group textarea:hover {
  border-color: #a1a1aa;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: #18181b;

  box-shadow:
    0 0 0 3px rgba(24, 24, 27, 0.08);
}

.form-group input:disabled,
.form-group select:disabled,
.form-group textarea:disabled {
  background: #f4f4f5;
  color: #a1a1aa;
  cursor: not-allowed;
}


/* =========================================================
   ERROR STATE
   ========================================================= */

.input-error {
  border-color: #dc2626 !important;
}

.input-error:focus {
  border-color: #dc2626 !important;

  box-shadow:
    0 0 0 3px rgba(220, 38, 38, 0.08) !important;
}

.field-error {
  margin-top: 6px;

  color: #dc2626;

  font-size: 12px;
  line-height: 1.45;
}

.field-help {
  margin: 7px 0 0;

  color: #71717a;

  font-size: 12px;
  line-height: 1.5;
}


/* =========================================================
   DATE INPUT
   ========================================================= */

.input-with-icon {
  position: relative;
}

.input-with-icon > svg {
  position: absolute;
  top: 50%;
  left: 12px;

  transform: translateY(-50%);

  color: #71717a;

  pointer-events: none;
}

.input-with-icon input {
  padding-left: 40px !important;
}


/* =========================================================
   CHECKBOX
   ========================================================= */

.form-checkbox-group {
  display: flex;
  flex-direction: column;
  justify-content: center;

  min-height: 70px;
}

.checkbox-label {
  display: inline-flex !important;
  align-items: center;
  gap: 9px;

  margin: 0 !important;

  cursor: pointer;
  user-select: none;
}

.checkbox-label input {
  width: 17px;
  height: 17px;

  margin: 0;

  accent-color: #18181b;

  cursor: pointer;
}

.checkbox-label span {
  color: #27272a;
  font-size: 13px;
  font-weight: 600;
}


/* =========================================================
   RICH TEXT EDITOR
   ========================================================= */

.rich-text-wrapper {
  overflow: hidden;

  border: 1px solid #d4d4d8;
  border-radius: 8px;

  background: #ffffff;

  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.rich-text-wrapper:focus-within {
  border-color: #18181b;

  box-shadow:
    0 0 0 3px rgba(24, 24, 27, 0.08);
}

.rich-text-toolbar {
  display: flex;
  align-items: center;
  gap: 3px;

  padding: 7px;

  border-bottom: 1px solid #e4e4e7;

  background: #fafafa;
}

.rich-text-toolbar button {
  min-width: 32px;
  height: 30px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border: 1px solid transparent;
  border-radius: 5px;

  background: transparent;
  color: #52525b;

  font-size: 13px;

  transition:
    background 160ms ease,
    border-color 160ms ease,
    color 160ms ease;
}

.rich-text-toolbar button:hover {
  border-color: #d4d4d8;
  background: #ffffff;
  color: #18181b;
}

.rich-text-editor {
  min-height: 130px;

  padding: 13px 14px;

  outline: none;

  color: #27272a;

  font-size: 13px;
  line-height: 1.6;

  overflow-wrap: anywhere;
  word-break: break-word;
}

.rich-text-editor:empty::before {
  content: "Enter address...";
  color: #a1a1aa;
  pointer-events: none;
}

.rich-text-editor p {
  margin: 0 0 8px;
}

.rich-text-editor p:last-child {
  margin-bottom: 0;
}

.rich-text-editor ul,
.rich-text-editor ol {
  margin-top: 6px;
  margin-bottom: 8px;
  padding-left: 22px;
}

.rich-text-editor strong,
.rich-text-editor b {
  font-weight: 700;
}

.rich-text-editor em,
.rich-text-editor i {
  font-style: italic;
}

.rich-text-editor u {
  text-decoration: underline;
}


/* =========================================================
   FILE UPLOAD SECTION
   ========================================================= */

.file-upload-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 20px;
}

.file-upload-card {
  min-width: 0;

  padding: 18px;

  border: 1px solid #e4e4e7;
  border-radius: 10px;

  background: #fafafa;
}

.file-upload-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  margin-bottom: 16px;

  color: #52525b;
}

.file-upload-header h4 {
  margin: 0;

  color: #27272a;

  font-size: 13px;
  font-weight: 700;
}

.file-upload-header p {
  margin: 5px 0 0;

  color: #a1a1aa;

  font-size: 11px;
}


/* =========================================================
   PROFILE IMAGE
   ========================================================= */

.profile-upload-area {
  width: 100%;
  min-height: 190px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  border: 1px dashed #d4d4d8;
  border-radius: 8px;

  background: #ffffff;
}

.profile-preview {
  width: 150px;
  height: 150px;

  object-fit: cover;

  border-radius: 50%;

  border: 1px solid #e4e4e7;
}

.profile-upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;

  color: #a1a1aa;

  font-size: 12px;
}


/* =========================================================
   DOCUMENT
   ========================================================= */

.document-preview {
  min-height: 190px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;

  padding: 20px;

  border: 1px dashed #d4d4d8;
  border-radius: 8px;

  background: #ffffff;

  color: #71717a;

  text-align: center;
}

.existing-document-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 8px;
  color: #2563eb;
  transition:
    background 160ms ease,
    color 160ms ease;
}

.existing-document-link:hover {
  background: #eff6ff;
  color: #1d4ed8;
}

.document-preview svg {
  color: #52525b;
}

.document-preview span {
  max-width: 100%;

  overflow-wrap: anywhere;

  font-size: 12px;
}


/* =========================================================
   FILE BUTTONS
   ========================================================= */

.file-upload-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;

  margin-top: 13px;
}

.file-upload-button,
.file-remove-button {
  min-height: 34px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  padding: 7px 11px;

  border-radius: 6px;

  font-size: 12px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background 160ms ease,
    border-color 160ms ease,
    color 160ms ease;
}

.file-upload-button {
  border: 1px solid #18181b;

  background: #18181b;
  color: #ffffff;
}

.file-upload-button:hover {
  background: #27272a;
  border-color: #27272a;
}

.file-remove-button {
  border: 1px solid #e4e4e7;

  background: #ffffff;
  color: #52525b;
}

.file-remove-button:hover {
  border-color: #fecaca;
  background: #fef2f2;
  color: #b91c1c;
}


/* =========================================================
   FORM FOOTER
   ========================================================= */

.user-form-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;

  padding: 20px 30px;

  border-top: 1px solid #e4e4e7;

  background: #fafafa;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.primary-button,
.secondary-button {
  min-height: 40px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 9px 16px;

  border-radius: 7px;

  font-size: 13px;
  font-weight: 600;

  transition:
    background 160ms ease,
    border-color 160ms ease,
    color 160ms ease,
    transform 160ms ease,
    box-shadow 160ms ease;
}

.primary-button {
  border: 1px solid #18181b;

  background: #18181b;
  color: #ffffff;
}

.primary-button:hover {
  background: #27272a;
  border-color: #27272a;
}

.primary-button:active {
  transform: translateY(1px);
}

.secondary-button {
  border: 1px solid #d4d4d8;

  background: #ffffff;
  color: #3f3f46;
}

.secondary-button:hover {
  border-color: #a1a1aa;
  background: #f4f4f5;
}

.primary-button:disabled,
.secondary-button:disabled,
.file-upload-button:disabled,
.file-remove-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 800px) {
  .form-grid,
  .file-upload-grid {
    grid-template-columns: 1fr;
  }

  .user-form-header,
  .form-section,
  .user-form-footer {
    padding-left: 20px;
    padding-right: 20px;
  }

  .form-status-error {
    margin-left: 20px;
    margin-right: 20px;
  }
}

@media (max-width: 560px) {
  .user-form-header {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .user-form-header h2 {
    font-size: 19px;
  }

  .form-section {
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .form-section-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }

  .user-form-footer {
    flex-direction: column-reverse;
    align-items: stretch;
  }

  .primary-button,
  .secondary-button {
    width: 100%;
  }

  .file-upload-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .file-upload-button,
  .file-remove-button {
    width: 100%;
  }
}